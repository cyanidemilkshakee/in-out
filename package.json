{
  "name": "in-out-management-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test:gateway": "docker compose -p inout-kong-test -f gateway/compose.test.yaml run --build --rm tests",
    "dev": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev -H ::1 -p 3001 --turbopack",
    "dev:bounded": "node scripts/run-with-timeout.mjs 900 node --max-http-header-size=65536 node_modules/next/dist/bin/next dev -H ::1 -p 3001 --turbopack",
    "dev:webpack": "node --max-http-header-size=65536 node_modules/next/dist/bin/next dev -H ::1 -p 3001",
    "build": "node scripts/run-with-timeout.mjs 600 node node_modules/next/dist/bin/next build",
    "start": "node --max-http-header-size=65536 node_modules/next/dist/bin/next start",
    "start:bounded": "node scripts/run-with-timeout.mjs 900 node --max-http-header-size=65536 node_modules/next/dist/bin/next start",
    "db:up": "docker compose up -d --wait postgres-primary",
    "db:down": "docker compose down",
    "setup:prepare": "node scripts/setup-prepare.mjs --prepare",
    "env:init": "node scripts/setup-prepare.mjs --init-only",
    "env:urls:sync": "node scripts/setup-prepare.mjs --urls-only",
    "deploy:shared": "node scripts/deploy-shared.mjs",
    "db:test:up": "docker compose --profile test up -d --wait db-test",
    "typecheck": "node scripts/run-with-timeout.mjs 120 node node_modules/typescript/bin/tsc --noEmit",
    "test:compile": "node scripts/run-with-timeout.mjs 120 node node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "test:frontend": "npm run test:compile && node scripts/run-test-group.mjs frontend",
    "test:auth": "npm run test:compile && node scripts/run-test-group.mjs auth",
    "test": "npm run test:compile && node scripts/run-test-group.mjs all",
    "test:all": "npm test && npm run test:postgres && npm run test:gateway",
    "keycloak:account:check": "node scripts/setup-keycloak.mjs --action account --check",
    "keycloak:account:repair": "node scripts/setup-keycloak.mjs --action account --apply",
    "keycloak:recovery:check": "node scripts/setup-keycloak.mjs --action recovery --check",
    "keycloak:recovery:apply": "node scripts/setup-keycloak.mjs --action recovery --apply",
    "keycloak:app-sign-in:check": "node scripts/setup-keycloak.mjs --action app-sign-in --check",
    "keycloak:app-sign-in:apply": "node scripts/setup-keycloak.mjs --action app-sign-in --apply",
    "keycloak:public-urls:check": "node scripts/setup-keycloak.mjs --action public-urls --check",
    "keycloak:public-urls:apply": "node scripts/setup-keycloak.mjs --action public-urls --apply",
    "keycloak:master-admin:check": "node scripts/setup-keycloak.mjs --action master-admin --check",
    "keycloak:master-admin:apply": "node scripts/setup-keycloak.mjs --action master-admin --apply",
    "keycloak:password-policy:check": "node scripts/setup-keycloak.mjs --action password-policy --check",
    "keycloak:password-policy:apply": "node scripts/setup-keycloak.mjs --action password-policy --apply",
    "keycloak:audit:check": "node scripts/setup-keycloak.mjs --action audit --check",
    "keycloak:audit:apply": "node scripts/setup-keycloak.mjs --action audit --apply",
    "test:auth:http": "node scripts/run-with-timeout.mjs 180 node scripts/test-keycloak-http.mjs",
    "test:auth:account": "node scripts/test-keycloak-account.mjs",
    "test:postgres": "docker compose --profile test run --build --rm backend-tests",
    "test:python": "uv run --project backend python -m unittest discover -s backend/tests",
    "keycloak:interactions:check": "node scripts/setup-keycloak.mjs --action interactions --check",
    "keycloak:interactions:apply": "node scripts/setup-keycloak.mjs --action interactions --apply",
    "keycloak:prepare": "node scripts/setup-keycloak.mjs",
    "test:keycloak:interactions": "node tests/keycloak-interactions.test.mjs",
    "keycloak:password-updates:check": "node scripts/setup-keycloak.mjs --action password-updates --check",
    "keycloak:password-updates:apply": "node scripts/setup-keycloak.mjs --action password-updates --apply",
    "keycloak:invitations:check": "node scripts/setup-keycloak.mjs --action invitations --check",
    "keycloak:invitations:apply": "node scripts/setup-keycloak.mjs --action invitations --apply",
    "env:secrets:generate": "node scripts/setup-prepare.mjs",
    "test:auth:password-updates": "node scripts/run-with-timeout.mjs 180 node scripts/test-password-updates-http.mjs"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "jose": "6.2.10",
    "lucide-react": "^0.468.0",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "critters": "^0.0.25",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.28"
    }
  }
}
