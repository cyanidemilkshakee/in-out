{
  "name": "in-out-management-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H ::1 -p 1001 --turbopack",
    "dev:bounded": "node scripts/run-with-timeout.mjs 900 node node_modules/next/dist/bin/next dev -H ::1 -p 1001 --turbopack",
    "dev:webpack": "next dev -H ::1 -p 1001",
    "build": "node scripts/run-with-timeout.mjs 600 node node_modules/next/dist/bin/next build",
    "start": "next start",
    "start:bounded": "node scripts/run-with-timeout.mjs 900 node node_modules/next/dist/bin/next start",
    "typecheck": "node scripts/run-with-timeout.mjs 120 node node_modules/typescript/bin/tsc --noEmit",
    "test:compile": "node scripts/run-with-timeout.mjs 120 node node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "test": "node scripts/run-with-timeout.mjs 120 node node_modules/typescript/bin/tsc -p tsconfig.test.json && node scripts/run-with-timeout.mjs 120 node .test-dist/tests/backend.integration.test.js"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "lucide-react": "^0.468.0",
    "next": "^15.3.3",
    "react": "^19.0.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "critters": "^0.0.25",
    "typescript": "^5.7.2"
  }
}
