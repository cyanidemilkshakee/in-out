{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "incremental": false,
    "outDir": ".test-dist",
    "rootDir": "."
  },
  "include": [
    "tests/**/*.ts",
    "lib/**/*.ts",
    "backend/**/*.ts",
    "services/profileService.ts"
  ],
  "exclude": ["node_modules", ".next"]
}
