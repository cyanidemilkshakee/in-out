# Local infrastructure defaults; replace secrets before deployment.
POSTGRES_PASSWORD=choose-a-local-postgres-password
POSTGRES_PORT=1003
REDIS_PORT=1004
KEYCLOAK_PORT=1005
# Current tested baseline; back up and verify realm changes before upgrading.
KEYCLOAK_VERSION=26.2.5
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=choose-a-keycloak-master-password
AUTH_SECRET=
APP_PORT=1008
APP_INTERNAL_PORT=3000
KONG_VERSION=3.9.3
PYTHON_API_PORT=1002
TEMPORAL_PORT=1006
TEMPORAL_UI_PORT=1007
AUTH_URL=http://localhost:1008

# Frontend: public issuer must match Keycloak tokens.
KEYCLOAK_CLIENT_ID=inout-frontend
# Generate a separate random secret for a NEW realm. For an existing realm,
# use Clients > inout-frontend > Credentials until you coordinate a rotation.
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ISSUER=http://localhost:1005/realms/inout
PYTHON_API_URL=http://127.0.0.1:1002
AUTH_TRUST_HOST=true

# Python (copy these into backend/.env for local uvicorn).
DATABASE_URL=postgresql+asyncpg://inout:inout@127.0.0.1:1003/inout
READ_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:1004/0
TEMPORAL_HOST=localhost:1006
ENV=production
KEYCLOAK_AUDIENCE=inout-frontend
KEYCLOAK_JWKS_CACHE_TTL=300
# Docker Compose supplies KEYCLOAK_JWKS_BASE for internal networking.
# Optional physical-terminal TLS: use compose.mtls.yaml, a secret of at least
# 32 random characters, and a directory with server.crt/server.key/client-ca.crt.
KONG_TERMINAL_SECRET=
KONG_TLS_DIR=
TERMINAL_TLS_PORT=10443
MAX_REQUEST_BODY_BYTES=262144
WRITE_RATE_LIMIT_PER_MINUTE=300
# Set a positive value only after agreeing a retention policy. Zero keeps the
# corresponding security record indefinitely.
IDEMPOTENCY_RETENTION_DAYS=30
NOTIFICATION_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=0
ALERT_RETENTION_DAYS=0
MOVEMENT_RETENTION_DAYS=0
