# Generate a different random URL-safe secret (32+ characters) for every field.
# Provisioning fails closed when database/Redis credentials are missing or weak.
# Existing volumes require the existing-volume maintenance procedure in README.md.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
MIGRATION_DB_PASSWORD=
KEYCLOAK_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
REDIS_QUOTA_PASSWORD=
REDIS_EVENTS_PASSWORD=
REDIS_GATEWAY_PASSWORD=
# Host-facing ports (loopback only): 1001-1011.
# API 1002, Keycloak 1005, Temporal UI 1007, app 1008,
# Keycloak admin 1009, Prometheus 1010, terminal mTLS 1011.
# Container listeners: Kong 1012-1017, app 1018, API 1019, PostgreSQL 1020,
# Redis 1021, Keycloak 1022/1023, Temporal 1024-1034, UI 1035, Prometheus 1036.
# Ports 1037-1100 are reserved for future container listeners.
PYTHON_API_PORT=1002
KEYCLOAK_PORT=1005
TEMPORAL_UI_HOST_PORT=1007
APP_PORT=1008
# Loopback-only Keycloak admin gateway starts with the default Compose stack.
KEYCLOAK_ADMIN_PORT=1009
PROMETHEUS_PORT=1010
TERMINAL_TLS_PORT=1011
# Patched release pin. Existing installations must back up and rehearse upgrades.
KEYCLOAK_VERSION=26.8.2
CADDY_VERSION=2.11.9-alpine
# Temporary Keycloak master-realm bootstrap account; only used on first initialization.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=setup-admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=
# Permanent Keycloak administrator for local maintenance scripts and demo seeding.
# Set these to your own master-realm admin after creating it; then retire the bootstrap values.
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
AUTH_SECRET=
KONG_VERSION=3.9.3
# Independent gateway-to-API authentication proof; never reuse AUTH_SECRET.
KONG_IDENTITY_SECRET=
# For shared deployment, replace these .localhost values with DNS names you own.
# Point both names to this server, set the URLs to matching HTTPS origins, then
# run `npm run deploy:shared`. Caddy is supplied by compose.shared.yaml.
APP_PUBLIC_HOSTNAME=app.localhost
KEYCLOAK_PUBLIC_HOSTNAME=auth.localhost
AUTH_URL=http://app.localhost:1008
KEYCLOAK_PUBLIC_URL=http://auth.localhost:1005
# Keep the isolated ingress subnet unused by your host/VPN/Docker networks.
# Only Caddy is trusted to forward visitor IPs to Kong for IP-based limits.
SHARED_INGRESS_SUBNET=172.30.250.0/29
SHARED_CADDY_IP=172.30.250.2
# Optional private/VPN HTTPS admin origin. Blank keeps the admin gateway
# loopback-only at http://auth.localhost:1009. Do not expose it publicly.
KEYCLOAK_ADMIN_ORIGIN=

# Frontend: public issuer must match Keycloak tokens.
KEYCLOAK_CLIENT_ID=inout-frontend
# Generate a separate random secret for a NEW realm. For an existing realm,
# use Clients > inout-frontend > Credentials until you coordinate a rotation.
KEYCLOAK_CLIENT_SECRET=
# Legacy native-reset migration/rollback settings; the app does not use them.
KEYCLOAK_PASSWORD_UPDATE_CLIENT_ID=inout-password-updates
KEYCLOAK_PASSWORD_UPDATE_CLIENT_SECRET=
KEYCLOAK_INVITE_CLIENT_ID=inout-invitations
# Configure this client as a confidential, server-only service account in Keycloak.
KEYCLOAK_INVITE_CLIENT_SECRET=
INVITE_TTL_SECONDS=900
INOUT_APP_URL=http://app.localhost:1008
PASSWORD_UPDATE_LOCK_API_URL=http://127.0.0.1:1019
# SMTP sender values for the app's invitation email. Docker Compose passes
# these values to the Python API; configure Keycloak's mail server separately.
KEYCLOAK_SMTP_HOST=
KEYCLOAK_SMTP_PORT=587
KEYCLOAK_SMTP_FROM=
KEYCLOAK_SMTP_FROM_DISPLAY_NAME=InOut Management
KEYCLOAK_SMTP_AUTH=true
KEYCLOAK_SMTP_USER=
KEYCLOAK_SMTP_PASSWORD=
KEYCLOAK_SMTP_STARTTLS=true
KEYCLOAK_SMTP_SSL=false
PYTHON_API_URL=http://127.0.0.1:1002
AUTH_TRUST_HOST=true

# Python: these names are set to internal scoped credentials by Compose.
# For manual development, use a disposable isolated test DB/cache or explicitly
# authenticated maintenance access. Infrastructure has no published host ports.
DATABASE_URL=
READ_DATABASE_URL=
# Direct PostgreSQL connections reuse prepared statements. Set to 0 when a
# transaction-pooled deployment does not preserve prepared statements.
DATABASE_STATEMENT_CACHE_SIZE=100
# Runtime reads/writes fail explicitly instead of waiting indefinitely. Lock
# waits must not exceed the statement deadline; transport commands allow 5s
# beyond the server statement bound. Complete exports still fail atomically.
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
DATABASE_LOCK_TIMEOUT_MS=3000
QUOTA_REDIS_URL=
EVENTS_REDIS_URL=
TEMPORAL_HOST=temporal:1024
KEYCLOAK_AUDIENCE=inout-frontend
KEYCLOAK_JWKS_CACHE_TTL=300
# Local Python API: use the same value as AUTH_SECRET for signed user-management
# windows. Docker Compose supplies this automatically from AUTH_SECRET.
KEYCLOAK_STEP_UP_SIGNING_SECRET=
# Docker Compose supplies KEYCLOAK_JWKS_BASE for internal networking.
# Optional physical-terminal TLS: use compose.mtls.yaml, a secret of at least
# 32 random characters, and a directory with server.crt/server.key/client-ca.crt.
KONG_TERMINAL_SECRET=
KONG_TLS_DIR=
MAX_REQUEST_BODY_BYTES=262144
# Request frequency limits are configured only in gateway/kong.yml.
# Shared verified-account budgets; reads and streams count serialized bytes.
DATA_BYTES_PER_MINUTE=67108864
MAX_DATA_RESPONSE_BYTES=16777216
MAX_SUBJECT_METADATA_BYTES=16384
DATA_SNAPSHOT_MAX_ROWS=10000
DATA_ANALYTICS_MAX_ROWS=50000
# Behavior throttles temporarily pause writes, never suspend an account.
BEHAVIOR_COOLDOWN_SECONDS=60
BEHAVIOR_FAILURES_PER_MINUTE=20
BEHAVIOR_UNKNOWN_BARCODES_PER_MINUTE=30
REQUEST_ADMISSION_CONCURRENCY=64
REQUEST_BODY_DEADLINE_SECONDS=30
INOUT_UPLOAD_IDLE_TIMEOUT_SECONDS=30
PRESENCE_STREAMS_PER_PRINCIPAL=3
PRESENCE_STREAMS_GLOBAL=128
PRESENCE_LEASE_SECONDS=45
QUOTA_REDIS_MAX_CONNECTIONS=64
EVENTS_REDIS_MAX_CONNECTIONS=160
# An over-capacity evaluation rejects atomically rather than reading a partial ledger.
ALERT_EVALUATION_MAX_SUBJECTS=5000
ALERT_EVALUATION_MAX_MOVEMENTS=50000
ALERT_EVALUATION_MAX_ALERTS=50000
ALERT_EVALUATION_MAX_RULES=1000
CHECKPOINT_EVALUATION_MAX_CHECKPOINTS=10000
CHECKPOINT_EVALUATION_MAX_ALERTS=10000
ATTENDANCE_WORKDAYS=0,1,2,3,4
ATTENDANCE_CUTOFF_HOUR=18
ATTENDANCE_CUTOFF_MINUTE=0
ATTENDANCE_GRACE_MINUTES=60
ATTENDANCE_HOLIDAYS=
# Set a positive value only after agreeing a retention policy. Zero keeps the
# corresponding security record indefinitely.
IDEMPOTENCY_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=0
ALERT_RETENTION_DAYS=0
MOVEMENT_RETENTION_DAYS=0
