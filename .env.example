# Local infrastructure defaults; replace secrets before deployment.
POSTGRES_PASSWORD=choose-a-local-postgres-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=choose-a-keycloak-master-password
AUTH_SECRET=
AUTH_URL=http://localhost:1001

# Frontend: public issuer must match Keycloak tokens.
KEYCLOAK_CLIENT_ID=inout-frontend
KEYCLOAK_CLIENT_SECRET=inout-frontend-secret
KEYCLOAK_ISSUER=http://localhost:8081/realms/inout
PYTHON_API_URL=http://127.0.0.1:8000
AUTH_TRUST_HOST=true

# Python (copy these into backend/.env for local uvicorn).
DATABASE_URL=postgresql+asyncpg://inout:inout@127.0.0.1:5432/inout
READ_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
TEMPORAL_HOST=localhost:7233
ENV=production
KEYCLOAK_AUDIENCE=inout-frontend
# Docker Compose supplies KEYCLOAK_JWKS_BASE for internal networking.
# MTLS_PROXY_SECRET is required only for the physical certificate gateway.
MTLS_PROXY_SECRET=
