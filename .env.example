# ─── Postgres ──────────────────────────────────────────────────────────────────
# asyncpg dialect required. Routes through PgBouncer (port 6432).
DATABASE_URL=postgresql+asyncpg://inout:inout@127.0.0.1:6432/inout

# Read replica — set this if you have a separate read replica (defaults to DATABASE_URL)
READ_DATABASE_URL=postgresql+asyncpg://inout:inout@127.0.0.1:5433/inout

# ─── Redis (Phase 2 — SSE Pub/Sub) ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Environment ───────────────────────────────────────────────────────────────
# Set to "dev" to bypass mTLS check when running without an API Gateway proxy.
ENV=dev

# ─── Docker Compose secrets ────────────────────────────────────────────────────
POSTGRES_PASSWORD=inout
PG_REPL_PASSWORD=repl_pass
KEYCLOAK_ADMIN_PASSWORD=admin
STEPCA_PASSWORD=password

# Keycloak NextAuth Configuration
KEYCLOAK_CLIENT_ID=inout-frontend
KEYCLOAK_CLIENT_SECRET=secret
KEYCLOAK_ISSUER=http://localhost:8080/realms/inout
AUTH_SECRET=generate-a-random-secret-here
